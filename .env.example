# DeepTrade settings: your money limits and switches. This is the only settings file.
#   cp .env.example .env
# The values below work together as shipped: they are conservative defaults that
# keep risk small while you watch the agent trade. Review them, then change only
# what you want different. A key left empty or removed falls back to its default.
# The agent sees every value at session start, along with any settings conflicts.
#
# How an agent trades (its symbols, asset class, hours, strategies, and cadence)
# is not set here. Each trading agent has a built-in profile in AGENT_PROFILES in
# .claude/hooks/lib.js, enforced by the risk gate, so editing this file cannot
# change an agent's behavior. A session without a profile cannot open positions.
# Keys from older versions (DEEPTRADE_ALLOWED_SYMBOLS, DEEPTRADE_STRATEGIES, the
# entry window, and so on) are ignored; the session start lists any still here.
#
# NOT FINANCIAL ADVICE. Defaults are risk limits, not recommendations to trade
# anything. See DISCLAIMER.md.
# Robinhood needs no key. Connect it with /mcp inside Claude Code.

# ── Switches: enforced by .claude/hooks/risk-gate.js ──

# Emergency stop. true blocks new entries. Exits and cancels still work.
DEEPTRADE_HALT=false
# Blocks everything including exits. Only cancels work.
DEEPTRADE_HALT_ALL=false
# Never these symbols, comma-separated, even if an agent's profile allows them.
# Options match by underlying.
DEEPTRADE_BLOCKED_SYMBOLS=

# ── Money limits: enforced by the risk gate on every opening order ──

# Per-order cap, from your account's equity and buying power at session start.
#   Neither set: 10% of equity.
#   Only USD:    that dollar amount while buying power covers it, else 10% of equity.
#   Only PCT:    that percent of equity.
#   Both:        the lower of the two.
DEEPTRADE_MAX_ORDER_USD=
DEEPTRADE_MAX_ORDER_PCT=
# Opening orders per day, shared by every agent running on the account.
# Every submitted entry counts, including one canceled unfilled. Exits, bank
# orders, and stop orders never count. Scalping strategies re-enter often, so the
# daily loss limit below is meant to stop a bad day before this cap does.
DEEPTRADE_MAX_ORDERS_PER_DAY=20
# true refuses entries whose value the gate cannot estimate, such as a market order with no amount.
DEEPTRADE_REQUIRE_KNOWN_VALUE=true
# Option entries only. true makes the gate read option exposure from the broker
# before each option entry: get_option_positions and get_option_orders for the
# account, under 2 minutes old and newer than the last order. It counts every
# position on the account, including ones you place by hand, against the agent's
# max positions, allows at most one open or pending call and one put at a time,
# refuses multi-leg entries, and lets one entry through at a time. Anything it
# cannot read blocks the entry.
DEEPTRADE_EXPOSURE_GUARD=true

# ── Money plan: followed by the agent ──

# The most one trade may lose, in percent of what that trade cost (not of the account).
# A ceiling: the stop is the tighter of the strategy's own stop and this. Size comes from
# the per-order cap above. Example: a $100 trade at 25 can lose at most $25.
# It is the most to lose while the setup still looks valid; strategy exits come first.
# The account as a whole is protected by the cap and DEEPTRADE_DAILY_LOSS_PCT.
# Under 15 is flagged: on same-day options it puts the stop inside normal noise.
DEEPTRADE_RISK_PER_TRADE_PCT=25
# Stop trading for the day once realized losses reach this percent of starting equity.
# With the defaults (10% per-order cap, 25% loss ceiling) one full loss is 2.5% of
# equity, so 10 stops the day after about four. Keep it above one full loss, or
# position-sizing shrinks every trade to fit and none may be placed.
DEEPTRADE_DAILY_LOSS_PCT=10
# Stop new entries for the day once realized profit reaches this percent of starting
# equity. 0 means no target. Open positions are still managed to their exits.
# In the replay in docs/research/replay-2026-11.md, a target near 4% of equity
# halved the trades and gave one more green day out of 20, but 38% less total
# profit. It is a way to stop early, not a source of profit.
DEEPTRADE_DAILY_PROFIT_TARGET_PCT=0

# ── Optional data sources: used only when a key is set ──
# Robinhood is the only required connection. Leave these empty to run without them.

# Unusual Whales: market data API for options flow, dark pool, Greeks, and more.
#
# Robinhood already provides what the shipped strategies need: bars, VWAP,
# quotes, option chains with Greeks, and an earnings calendar.
# What Unusual Whales adds for the agents:
#   - Options flow and unusual activity, dark pool prints, gamma exposure, and
#     market tide, for ranking the pre-market shortlist and reading the
#     session's tone.
#   - An economic calendar (CPI, FOMC, jobs reports) for the no-trade windows.
#   - Longer history and screeners, for strategies that need them.
# This is context and data, not a trade signal by itself, and it does not
# guarantee better results. Every entry still needs an enabled strategy rule.
#
# How to get a key:
#   1. Buy an API plan at https://unusualwhales.com/pricing?product=api
#      This is separate from the regular Unusual Whales app subscription.
#      Plans as listed on 2026-11-03, check the page for current terms:
#        starter   ~$99/mo, 25,000 requests a month, 1 year of history
#        basic     ~$150/mo, unlimited daily requests, 2 years of history
#        advanced  ~$375/mo, adds live futures streaming, which the agents
#                  cannot use through MCP, so basic covers what they use
#   2. Copy your key from https://unusualwhales.com/dashboard/api
#   3. Paste it below, set the plan, and restart Claude Code.
#
# Needs Node 20 or newer (check with `node -v`); the agent tells you if yours is older.
# The key stays in this file: .mcp.json only names it,
# and trading agents are blocked from reading this file.
UNUSUAL_WHALES_API_KEY=
# Your API plan: starter, basic, or advanced. Agents pace their data use to it.
DEEPTRADE_UNUSUAL_WHALES_PLAN=
