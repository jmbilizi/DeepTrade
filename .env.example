# DeepTrade guardrails
# Copy this file to .env and edit the values. These are hard caps enforced by
# .claude/hooks/risk-gate.js before any order reaches the broker.
# Robinhood needs no key here. Connect it with /mcp inside Claude Code.
#
# NOT FINANCIAL ADVICE. Every symbol and number in this file is a placeholder
# chosen to show the format. It is not a recommendation to trade anything.
# Choose your own values. See DISCLAIMER.md.

# Emergency stop. true blocks every order tool call immediately. Cancels still work.
DEEPTRADE_HALT=false

# Blocks everything including exits. Only cancels work. For emergencies.
DEEPTRADE_HALT_ALL=false

# Restrict to asset classes the agent may open: equity, option, crypto. Empty allows all.
DEEPTRADE_ALLOWED_ASSET_CLASSES=equity

# Market-time window for new entries, HH:MM. Empty disables. Exits are never time-blocked.
DEEPTRADE_NO_NEW_ENTRIES_BEFORE=09:35
DEEPTRADE_NO_NEW_ENTRIES_AFTER=15:00

# true refuses any entry whose dollar value the gate cannot estimate, such as a market order with no amount.
DEEPTRADE_REQUIRE_KNOWN_VALUE=false

# true treats plain sells as entries too. Set it if your account can short.
DEEPTRADE_GATE_SELLS=false

# Per-order cap in US dollars. The agent may never send a single order worth more than this.
DEEPTRADE_MAX_ORDER_USD=500

# Per-order cap as a percent of account equity. The lower of this and the dollar cap wins,
# so a 1,000 dollar account with 10 here is capped at 100 per order, not 500.
# Requires the agent to record equity in journal/session-state.json at session start.
DEEPTRADE_MAX_ORDER_PCT=10

# Maximum order submissions per calendar day, counted from journal/orders.jsonl.
DEEPTRADE_MAX_ORDERS_PER_DAY=10

# Symbols the agent may never trade. Comma-separated, no spaces required. Empty means none.
DEEPTRADE_BLOCKED_SYMBOLS=

# If set, the agent may trade only these symbols. Empty means any symbol is allowed.
# QQQ and SPY below are format examples only, not a suggestion. Use your own list.
DEEPTRADE_ALLOWED_SYMBOLS=QQQ,SPY

# Timezone used for market-hours context at session start.
DEEPTRADE_TIMEZONE=America/New_York